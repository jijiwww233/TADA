# 千问兼容接口地址。不填时无法验证网页里输入的 Key，也无法调用云端。
AI_BASE_URL=
# 你自己的千问 API Key。不填时可以离线使用，云端分析不可用。
AI_API_KEY=
# 百炼控制台里已开通、支持图片输入的模型名。不填时不能分析图片。
VISION_MODEL=
# 普通图片分析同时处理的张数。留空默认 6，可填 1 至 32。遇到限流可调低。
ANALYSIS_CONCURRENCY=
# 后端启动时是否开启普通分析队列。留空仅桌面模式默认开启；填 0 关闭，填 1 开启。
# 只有云端地址、Key 和视觉模型都配置好才会自动启动，分析可能产生费用。
ANALYSIS_AUTO_START=
# 云端文字向量的模型名。不填时使用程序内置默认型号。
EMBEDDING_MODEL=
# 本地找图模型的目录。不填时使用 data/models/chinese-clip-base。
CHINESE_CLIP_MODEL_DIR=
# 模型下载来源。不填时使用 Hugging Face 官方站，可以按需填写 HTTPS 镜像。
HF_ENDPOINT=
# 快捷指令使用的独立上传码。不填时，网页仍可导入，快捷指令接口停用。
SHORTCUT_UPLOAD_TOKEN=
# 「收进 TADA」快捷指令的 iCloud 安装链接，只在本机 .env 中配置。
SHORTCUT_INSTALL_URL=
# 微信公众平台测试号页面显示的 AppID。当前明文回调和 PicUrl 下载无需使用它。
WECHAT_APPID=
# 微信公众平台测试号的接口验证 Token，需与测试号后台一致。
WECHAT_TOKEN=
